@model IEnumerable<CASO2.Data.UserDetail>

    @{
        ViewBag.Title = "Cleanup completed";
    }

    <h2>Data cleaning completed</h2>

    <p>The cleaning pipeline has finished successfully. All stages were applied and data is marked as Ready.</p>

    <p>
        @Html.ActionLink("Back to Paso1", "Paso1", "Data", null, new { @class = "btn btn-primary" })
    </p>

    <style>
        .table-scrollable {
            max-height: 60vh;
            overflow: auto;
            -webkit-overflow-scrolling: touch;
        }

            .table-scrollable thead th {
                position: sticky;
                top: 0;
                background: #fff;
                z-index: 2;
            }

            .table-scrollable td, .table-scrollable th {
                white-space: nowrap;
            }
    </style>

    <div class="table-scrollable mt-3">
        <table class="table table-striped table-bordered table-sm mb-0">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Address</th>
                    <th>PostalZip</th>
                    <th>Region</th>
                    <th>Country</th>
                    <th>List</th>
                    <th>Text</th>
                    <th>NumberRange</th>
                    <th>Salary</th>
                    <th>Password</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td>@item.Phone</td>
                        <td>@item.Email</td>
                        <td>@item.Address</td>
                        <td>@item.PostalZip</td>
                        <td>@item.Region</td>
                        <td>@item.Country</td>
                        <td>@item.List</td>
                        <td>@item.Text</td>
                        <td>@item.NumberRange</td>
                        <td>@item.Salary</td>
                        <td>@item.Password</td>
                        <td>@item.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
