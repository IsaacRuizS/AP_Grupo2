@model IEnumerable<FB.Data.UserDetail>

@{
    ViewBag.Title = "Paso 1 (Eliminar Rusia / China)";
}

<div class="stage-container">
    <div class="stage-hero">
        <div class="stage-badge">Paso 1</div>
        <h2 class="stage-title">Eliminar los registros (Rusia / China)</h2>
        <p class="stage-subtitle">
            Este paso elimina usuarios de <strong>Russia</strong> y <strong>China</strong> y marca los registros como procesados.
        </p>

        @if (!string.IsNullOrEmpty(ViewBag.Message as string))
        {
            <div class="stage-alert">
                @ViewBag.Message
            </div>
        }

        @using (Html.BeginForm("RunStage", "Data", FormMethod.Post, new { @class = "stage-form" }))
        {
            @Html.AntiForgeryToken()
            @Html.Hidden("stage", "1")
            @Html.Hidden("returnTo", "Paso1")

            <button type="submit" class="btn-neo-primary">
                <span class="btn-neo-glow"></span>
                <span class="btn-neo-label">Ejecutar</span>
            </button>
        }
    </div>

    <div class="data-card">
        <div class="data-card-header">

            <div class="data-card-legend">
                <span class="pill pill-info">Id</span>
                <span class="pill pill-soft">Datos personales</span>
                <span class="pill pill-outline">Estado</span>
            </div>
        </div>

        <div class="data-table-wrapper">
            <table class="neo-table">
                <thead>
                    <tr>
                        <th class="col-id">ID</th>
                        <th>Nombre</th>
                        <th>Teléfono</th>
                        <th>Email</th>
                        <th>Dirección</th>
                        <th>Código Postal</th>
                        <th>Región</th>
                        <th>País</th>
                        <th>Lista</th>
                        <th>Etapa</th>
                        <th>Rango</th>
                        <th>Salario</th>
                        <th>Password</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="col-id">
                            <span class="pill pill-id">@item.Id</span>
                        </td>
                        <td>
                            <div class="cell-main">@item.Name</div>
                        </td>
                        <td>
                            <div class="cell-sub">@item.Phone</div>
                        </td>
                        <td>
                            <div class="cell-main">@item.Email</div>
                        </td>
                        <td>
                            <div class="cell-sub">@item.Address</div>
                        </td>
                        <td>
                            <span class="pill pill-soft">@item.PostalZip</span>
                        </td>
                        <td>@item.Region</td>
                        <td>
                            <span class="pill pill-country">
                                @item.Country
                            </span>
                        </td>
                        <td>@item.List</td>
                        <td>
                            <span class="pill pill-stage">
                                @item.Text
                            </span>
                        </td>
                        <td>
                            <span class="pill pill-range">
                                @item.NumberRange
                            </span>
                        </td>
                        <td>@item.Salary</td>
                        <td>
                            <span class="pill pill-danger">
                                @item.Password
                            </span>
                        </td>
                        <td>
                            <span class="pill @(string.Equals(item.Status, "Ready", StringComparison.OrdinalIgnoreCase) ? "pill-status-ready" : "pill-status-default")">
                                @item.Status
                            </span>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .stage-container {
        position: relative;
        padding: 2.5rem 1.5rem 3rem;
        background: radial-gradient(circle at top left, #a7f3ff 0, #f3e9ff 32%, #0f172a 100%);
        border-radius: 24px;
        box-shadow:
            0 24px 60px rgba(15, 23, 42, 0.55),
            inset 0 0 0 1px rgba(255, 255, 255, 0.04);
        overflow: hidden;
    }

    .stage-container::before {
        content: "";
        position: absolute;
        top: -120px;
        right: -80px;
        width: 260px;
        height: 260px;
        background: radial-gradient(circle, rgba(56, 189, 248, 0.75), transparent 60%);
        filter: blur(4px);
        opacity: 0.8;
        pointer-events: none;
    }

    .stage-container::after {
        content: "";
        position: absolute;
        bottom: -140px;
        left: -40px;
        width: 260px;
        height: 260px;
        background: radial-gradient(circle, rgba(192, 132, 252, 0.9), transparent 65%);
        filter: blur(4px);
        opacity: 0.7;
        pointer-events: none;
    }

    .stage-hero {
        position: relative;
        z-index: 1;
        margin-bottom: 2rem;
    }

    .stage-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.3rem 0.9rem;
        border-radius: 999px;
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        background: linear-gradient(120deg, rgba(15, 23, 42, 0.92), rgba(30, 64, 175, 0.9));
        color: #e0f2fe;
        box-shadow:
            0 0 0 1px rgba(148, 163, 184, 0.4),
            0 10px 24px rgba(15, 23, 42, 0.7);
    }

    .stage-title {
        margin-top: 0.9rem;
        margin-bottom: 0.25rem;
        font-size: 1.7rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        color: #f9fafb;
        text-shadow: 0 8px 24px rgba(15, 23, 42, 0.9);
    }

    .stage-subtitle {
        margin: 0;
        max-width: 640px;
        font-size: 0.9rem;
        color: #e5e7eb;
        opacity: 0.9;
    }

    .stage-alert {
        margin-top: 1rem;
        padding: 0.75rem 1rem;
        border-radius: 16px;
        font-size: 0.85rem;
        background: linear-gradient(135deg, rgba(22, 163, 74, 0.12), rgba(187, 247, 208, 0.15));
        color: #dcfce7;
        border: 1px solid rgba(34, 197, 94, 0.45);
        box-shadow: 0 18px 40px rgba(22, 163, 74, 0.4);
        backdrop-filter: blur(8px);
    }

    .stage-form {
        margin-top: 1.4rem;
    }

    .btn-neo-primary {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border-radius: 999px;
        border: none;
        background: transparent;
        cursor: pointer;
        text-decoration: none;
    }

    .btn-neo-primary:focus {
        outline: none;
    }

    .btn-neo-glow {
        position: absolute;
        inset: -1px;
        border-radius: inherit;
        background:
            linear-gradient(135deg, rgba(94, 234, 212, 0.8), rgba(59, 130, 246, 0.9), rgba(192, 132, 252, 0.85));
        filter: blur(4px);
        opacity: 0.8;
        transition: opacity 0.2s ease, transform 0.2s ease;
        z-index: 0;
    }

    .btn-neo-label {
        position: relative;
        z-index: 1;
        padding: 0.65rem 1.6rem;
        border-radius: inherit;
        background: radial-gradient(circle at 0% 0%, #0f172a, #020617);
        color: #e0f2fe;
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        box-shadow:
            0 18px 40px rgba(15, 23, 42, 0.9),
            inset 0 0 0 1px rgba(148, 163, 184, 0.55);
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
    }

    .btn-neo-label::before {
        content: "●";
        font-size: 0.6rem;
        color: #22c55e;
        text-shadow: 0 0 12px rgba(34, 197, 94, 0.9);
    }

    .btn-neo-primary:hover .btn-neo-glow {
        opacity: 1;
        transform: scale(1.03);
    }

    .btn-neo-primary:hover .btn-neo-label {
        transform: translateY(-1px);
    }

    .data-card {
        position: relative;
        z-index: 1;
        margin-top: 2.2rem;
        border-radius: 22px;
        padding: 1.4rem 1.3rem 1.2rem;
        background: linear-gradient(135deg, rgba(15, 23, 42, 0.92), rgba(15, 23, 42, 0.98));
        box-shadow:
            0 22px 50px rgba(15, 23, 42, 0.9),
            0 0 0 1px rgba(148, 163, 184, 0.35);
        backdrop-filter: blur(18px);
    }

    .data-card-header {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.8rem 1rem;
        margin-bottom: 1rem;
    }

    .data-card-title {
        margin: 0;
        font-size: 1.1rem;
        color: #f9fafb;
        letter-spacing: 0.03em;
    }

    .data-card-subtitle {
        margin: 0.2rem 0 0;
        font-size: 0.8rem;
        color: #9ca3af;
    }

    .data-card-legend {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        flex-wrap: wrap;
    }

    .pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.1rem 0.6rem;
        border-radius: 999px;
        font-size: 0.7rem;
        line-height: 1.2;
        border: 1px solid rgba(148, 163, 184, 0.4);
        background: rgba(15, 23, 42, 0.8);
        color: #e5e7eb;
        backdrop-filter: blur(8px);
        white-space: nowrap;
    }

    .pill-info {
        background: linear-gradient(135deg, rgba(56, 189, 248, 0.22), rgba(37, 99, 235, 0.16));
        border-color: rgba(56, 189, 248, 0.6);
        color: #e0f2fe;
    }

    .pill-soft {
        background: rgba(30, 64, 175, 0.35);
        border-color: rgba(129, 140, 248, 0.7);
    }

    .pill-outline {
        background: transparent;
        border-style: dashed;
    }

    .pill-id {
        background: radial-gradient(circle at 10% 0%, rgba(56, 189, 248, 0.35), rgba(15, 23, 42, 0.95));
        border-color: rgba(56, 189, 248, 0.7);
        color: #e0f2fe;
    }

    .pill-country {
        background: radial-gradient(circle at 0 0, rgba(129, 140, 248, 0.5), rgba(15, 23, 42, 0.95));
        border-color: rgba(129, 140, 248, 0.8);
        color: #e5e5ff;
    }

    .pill-stage {
        background: rgba(22, 163, 74, 0.2);
        border-color: rgba(22, 163, 74, 0.8);
        color: #bbf7d0;
    }

    .pill-range {
        background: rgba(234, 179, 8, 0.18);
        border-color: rgba(250, 204, 21, 0.9);
        color: #fef9c3;
    }

    .pill-danger {
        background: rgba(220, 38, 38, 0.18);
        border-color: rgba(248, 113, 113, 0.9);
        color: #fecaca;
    }

    .pill-status-ready {
        background: linear-gradient(135deg, rgba(22, 163, 74, 0.8), rgba(34, 197, 94, 0.95));
        border-color: rgba(74, 222, 128, 1);
        color: #ecfdf5;
        box-shadow: 0 0 16px rgba(34, 197, 94, 0.7);
    }

    .pill-status-default {
        background: rgba(55, 65, 81, 0.85);
        border-color: rgba(148, 163, 184, 0.9);
        color: #e5e7eb;
    }

    .data-table-wrapper {
        max-height: 60vh;
        overflow: auto;
        border-radius: 18px;
        border: 1px solid rgba(31, 41, 55, 0.9);
        background:
            radial-gradient(circle at top left, rgba(30, 64, 175, 0.46), transparent 55%),
            radial-gradient(circle at bottom right, rgba(236, 72, 153, 0.36), transparent 55%),
            rgba(15, 23, 42, 0.96);
        box-shadow:
            inset 0 0 0 1px rgba(148, 163, 184, 0.12),
            0 18px 35px rgba(15, 23, 42, 0.9);
        backdrop-filter: blur(12px);
    }

    .data-table-wrapper::-webkit-scrollbar {
        height: 8px;
        width: 8px;
    }

    .data-table-wrapper::-webkit-scrollbar-track {
        background: transparent;
    }

    .data-table-wrapper::-webkit-scrollbar-thumb {
        background: rgba(148, 163, 184, 0.7);
        border-radius: 999px;
    }

    .neo-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 0.78rem;
        color: #e5e7eb;
    }

    .neo-table thead th {
        position: sticky;
        top: 0;
        z-index: 5;
        background:
            linear-gradient(135deg, rgba(15, 23, 42, 0.98), rgba(15, 23, 42, 0.94));
        backdrop-filter: blur(14px);
        text-align: left;
        padding: 0.65rem 0.75rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-size: 0.65rem;
        border-bottom: 1px solid rgba(55, 65, 81, 1);
        box-shadow: 0 8px 16px rgba(15, 23, 42, 0.9);
        white-space: nowrap;
    }

    .neo-table thead th:first-child {
        border-top-left-radius: 18px;
    }

    .neo-table thead th:last-child {
        border-top-right-radius: 18px;
    }

    .neo-table tbody tr {
        transition: background 0.12s ease, transform 0.08s ease, box-shadow 0.12s ease;
    }

    .neo-table tbody tr:nth-child(odd) {
        background: rgba(15, 23, 42, 0.85);
    }

    .neo-table tbody tr:nth-child(even) {
        background: rgba(15, 23, 42, 0.95);
    }

    .neo-table tbody tr:hover {
        background: radial-gradient(circle at 0 0, rgba(56, 189, 248, 0.22), rgba(15, 23, 42, 1));
        transform: translateY(-1px);
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.95);
    }

    .neo-table td {
        padding: 0.55rem 0.75rem;
        border-bottom: 1px solid rgba(31, 41, 55, 0.95);
        white-space: nowrap;
        vertical-align: middle;
    }

    .neo-table tbody tr:last-child td:first-child {
        border-bottom-left-radius: 18px;
    }

    .neo-table tbody tr:last-child td:last-child {
        border-bottom-right-radius: 18px;
    }

    .col-id {
        width: 1%;
    }

    .cell-main {
        font-weight: 500;
        color: #f9fafb;
    }

    .cell-sub {
        font-size: 0.7rem;
        color: #9ca3af;
    }

    @@media (max-width: 768px) {
        .stage-container {
            padding: 1.5rem 1rem 2rem;
            border-radius: 16px;
        }

        .stage-title {
            font-size: 1.4rem;
        }

        .data-card {
            padding: 1rem;
        }

        .neo-table thead th,
        .neo-table td {
            padding: 0.45rem 0.5rem;
        }
    }
</style>
