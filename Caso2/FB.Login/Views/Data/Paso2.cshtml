@model IEnumerable<FB.Data.UserDetail>

    @{
        ViewBag.Title = "Paso 2 (Eliminar PII / Phone)";
    }

    <div class="stage2-container">
        <div class="stage2-hero">
            <div class="stage2-badge">Paso 2</div>

            <h2 class="stage2-title">Eliminar (PII / Phone)</h2>

            @if (!string.IsNullOrEmpty(ViewBag.Message as string))
            {
                <div class="stage2-alert">
                    @ViewBag.Message
                </div>
            }

            @using (Html.BeginForm("RunStage", "Data", FormMethod.Post, new { @class = "stage2-form" }))
            {
                @Html.AntiForgeryToken()
                @Html.Hidden("stage", "2")
                @Html.Hidden("returnTo", "Paso2")

                <button type="submit" class="btn-neo2-primary">
                    <span class="btn2-glow"></span>
                    <span class="btn2-label">Ejecutar</span>
                </button>
            }
        </div>

        <div class="data2-card">
            <div class="data2-card-header">

                <div class="data2-card-legend">
                    <span class="pill2 pill2-id">ID</span>
                    <span class="pill2 pill2-field">PII</span>
                    <span class="pill2 pill2-status">Estado</span>
                </div>
            </div>

            <div class="data2-table-wrapper">
                <table class="neo2-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Phone (PII)</th>
                            <th>Email</th>
                            <th>Dirección</th>
                            <th>PostalZip</th>
                            <th>Región</th>
                            <th>País</th>
                            <th>Lista</th>
                            <th>Etapa</th>
                            <th>Rango</th>
                            <th>Salario</th>
                            <th>Password</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="pill2 pill2-id">@item.Id</span></td>
                                <td>@item.Name</td>

                                <td>
                                    <span class="pill2 pill2-field">@item.Phone</span>
                                </td>

                                <td>@item.Email</td>
                                <td>@item.Address</td>
                                <td>@item.PostalZip</td>
                                <td>@item.Region</td>
                                <td>@item.Country</td>
                                <td>@item.List</td>

                                <td><span class="pill2 pill2-stage">@item.Text</span></td>
                                <td><span class="pill2 pill2-range">@item.NumberRange</span></td>
                                <td>@item.Salary</td>

                                <td>
                                    <span class="pill2 pill2-danger">@item.Password</span>
                                </td>

                                <td>
                                    <span class="pill2 @(item.Status == "Ready" ? "pill2-ready" : "pill2-normal")">
                                        @item.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <style>


                .stage2-container {
                    position: relative;
                    padding: 2.5rem 1.5rem 3rem;
                    background: radial-gradient(circle at top right, #7fffd4 0%, #0ea5e9 35%, #0f172a 100%);
                    border-radius: 24px;
                    overflow: hidden;
                    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.6), inset 0 0 0 1px rgba(255, 255, 255, 0.05);
                }

                    .stage2-container::before {
                        content: "";
                        position: absolute;
                        top: -120px;
                        left: -70px;
                        width: 240px;
                        height: 240px;
                        background: radial-gradient(circle, rgba(16, 185, 129, 0.65), transparent 70%);
                        filter: blur(6px);
                    }

                    .stage2-container::after {
                        content: "";
                        position: absolute;
                        bottom: -130px;
                        right: -40px;
                        width: 260px;
                        height: 260px;
                        background: radial-gradient(circle, rgba(14, 165, 233, 0.7), transparent 70%);
                        filter: blur(6px);
                    }

                .stage2-hero {
                    position: relative;
                    z-index: 2;
                }

                .stage2-badge {
                    display: inline-block;
                    padding: 0.3rem 1rem;
                    background: linear-gradient(135deg, rgba(16, 185, 129, 0.85), rgba(14, 165, 233, 0.85));
                    border-radius: 999px;
                    font-size: 0.75rem;
                    letter-spacing: 0.05em;
                    color: #f0fdfa;
                    text-transform: uppercase;
                    box-shadow: 0 0 10px rgba(14, 165, 233, 0.8);
                }

                .stage2-title {
                    color: #e0f7fa;
                    text-shadow: 0 6px 18px rgba(0, 0, 0, 0.6);
                    font-weight: 700;
                }

                .stage2-subtitle {
                    margin-top: 0.6rem;
                    color: #cffafe;
                    opacity: 0.85;
                    font-size: 0.9rem;
                }

                .stage2-alert {
                    margin-top: 1rem;
                    padding: 0.75rem 1rem;
                    border-radius: 16px;
                    background: rgba(16, 185, 129, 0.25);
                    backdrop-filter: blur(8px);
                    color: #d1fae5;
                    font-size: 0.9rem;
                    border: 1px solid rgba(52, 211, 153, 0.6);
                }

                .btn-neo2-primary {
                    position: relative;
                    border: none;
                    cursor: pointer;
                    background: transparent;
                    margin-top: 1.2rem;
                }

                .btn2-glow {
                    position: absolute;
                    inset: -2px;
                    border-radius: 999px;
                    background: linear-gradient(135deg, #06b6d4, #0ea5e9, #22d3ee);
                    filter: blur(6px);
                    opacity: 0.85;
                    transition: 0.2s;
                }

                .btn2-label {
                    padding: 0.65rem 1.6rem;
                    font-size: 0.9rem;
                    background: rgba(0, 20, 40, 0.9);
                    color: #a7f3d0;
                    border-radius: 999px;
                    border: 1px solid rgba(14, 165, 233, 0.5);
                    text-transform: uppercase;
                    letter-spacing: 0.05em;
                    position: relative;
                    z-index: 1;
                }

                .btn-neo2-primary:hover .btn2-glow {
                    opacity: 1;
                    transform: scale(1.04);
                }

                .data2-card {
                    margin-top: 2rem;
                    background: rgba(2, 20, 34, 0.75);
                    border-radius: 22px;
                    padding: 1.4rem;
                    backdrop-filter: blur(14px);
                    border: 1px solid rgba(45, 212, 191, 0.22);
                    box-shadow: 0 22px 40px rgba(0, 0, 0, 0.7), inset 0 0 0 1px rgba(255, 255, 255, 0.05);
                }

                .data2-card-title {
                    color: #e0f7fa;
                }

                .data2-card-subtitle {
                    color: #94a3b8;
                    font-size: 0.8rem;
                    margin-top: 0.2rem;
                }

                .data2-card-header {
                    display: flex;
                    justify-content: space-between;
                    margin-bottom: 1rem;
                }

                .pill2 {
                    padding: 0.1rem 0.6rem;
                    border-radius: 999px;
                    font-size: 0.7rem;
                    border: 1px solid rgba(148, 163, 184, 0.3);
                    backdrop-filter: blur(6px);
                }

                .pill2-id {
                    background: rgba(14, 165, 233, 0.3);
                    border-color: rgba(14, 165, 233, 0.7);
                    color: #e0f7fa;
                }

                .pill2-field {
                    background: rgba(52, 211, 153, 0.25);
                    border-color: rgba(52, 211, 153, 0.8);
                    color: #d1fae5;
                }

                .pill2-stage {
                    background: rgba(14, 165, 233, 0.2);
                    border-color: rgba(14, 165, 233, 0.7);
                }

                .pill2-range {
                    background: rgba(234, 179, 8, 0.25);
                    border-color: rgba(250, 204, 21, 0.9);
                }

                .pill2-danger {
                    background: rgba(244, 63, 94, 0.2);
                    border-color: rgba(244, 63, 94, 0.8);
                    color: #fecdd3;
                }

                .pill2-ready {
                    background: rgba(34, 197, 94, 0.9);
                    color: white;
                }

                .pill2-normal {
                    background: rgba(55, 65, 81, 0.6);
                    color: #e5e5e5;
                }


                .data2-table-wrapper {
                    max-height: 60vh;
                    overflow: auto;
                    border-radius: 18px;
                    border: 1px solid rgba(14, 165, 233, 0.3);
                    background: rgba(2, 20, 34, 0.6);
                }

                .neo2-table {
                    width: 100%;
                    border-collapse: separate;
                    border-spacing: 0;
                    color: #e0f7fa;
                    font-size: 0.82rem;
                }

                    .neo2-table thead th {
                        position: sticky;
                        top: 0;
                        background: rgba(2, 20, 34, 0.95);
                        padding: 0.65rem;
                        border-bottom: 1px solid rgba(14, 165, 233, 0.4);
                        text-transform: uppercase;
                        letter-spacing: 0.08em;
                        font-size: 0.7rem;
                    }

                    .neo2-table tbody tr {
                        transition: 0.12s;
                    }

                        .neo2-table tbody tr:nth-child(even) {
                            background: rgba(3, 30, 50, 0.7);
                        }

                        .neo2-table tbody tr:nth-child(odd) {
                            background: rgba(2, 24, 40, 0.7);
                        }

                        .neo2-table tbody tr:hover {
                            background: rgba(16, 185, 129, 0.15);
                            transform: translateY(-1px);
                            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.7);
                        }

                    .neo2-table td {
                        padding: 0.55rem 0.75rem;
                        border-bottom: 1px solid rgba(14, 165, 233, 0.25);
                    }
    </style>
