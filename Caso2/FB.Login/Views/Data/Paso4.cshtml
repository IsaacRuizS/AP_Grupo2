@model IEnumerable<FB.Data.UserDetail>

    @{
        ViewBag.Title = "Paso 4 (Finalizar y marcar como ready)";
    }

    <div class="stage4-container">
        <div class="stage4-hero">
            <div class="stage4-badge">Paso 4</div>

            <h2 class="stage4-title">Finalizar y marcar como ready</h2>

            @if (!string.IsNullOrEmpty(ViewBag.Message as string))
            {
                <div class="stage4-alert">
                    @ViewBag.Message
                </div>
            }

            @using (Html.BeginForm("RunStage", "Data", FormMethod.Post, new { @class = "stage4-form" }))
            {
                @Html.AntiForgeryToken()
                @Html.Hidden("stage", "4")
                @Html.Hidden("returnTo", "Paso4")

                <button type="submit" class="btn-neo4-primary">
                    <span class="btn4-glow"></span>
                    <span class="btn4-label">Ejecutar</span>
                </button>
            }
        </div>

        <div class="data4-card">
            <div class="data4-card-header">

                <div class="data4-card-legend">
                    <span class="pill4 pill4-id">ID</span>
                    <span class="pill4 pill4-status">Estado</span>
                    <span class="pill4 pill4-ready">Ready</span>
                </div>
            </div>

            <div class="data4-table-wrapper">
                <table class="neo4-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>Address</th>
                            <th>PostalZip</th>
                            <th>Region</th>
                            <th>Country</th>
                            <th>List</th>
                            <th>Etapa</th>
                            <th>Range</th>
                            <th>Salary</th>
                            <th>Password</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="pill4 pill4-id">@item.Id</span>
                                </td>
                                <td>@item.Name</td>
                                <td>@item.Phone</td>
                                <td>@item.Email</td>
                                <td>@item.Address</td>
                                <td>@item.PostalZip</td>
                                <td>@item.Region</td>
                                <td>@item.Country</td>
                                <td>@item.List</td>
                                <td>
                                    <span class="pill4 pill4-stage">@item.Text</span>
                                </td>
                                <td>@item.NumberRange</td>
                                <td>@item.Salary</td>
                                <td>
                                    <span class="pill4 pill4-sensitive">@item.Password</span>
                                </td>
                                <td>
                                    <span class="pill4 @(item.Status == "Ready" ? "pill4-ready" : "pill4-status")">
                                        @item.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <style>

.stage4-container {
    position: relative;
    padding: 2.5rem 1.5rem 3rem;
    border-radius: 24px;
    background:
        radial-gradient(circle at top left, #1f2937 0%, #020617 55%, #020617 100%);
    overflow: hidden;
    box-shadow:
        0 30px 80px rgba(15, 23, 42, 0.95),
        inset 0 0 0 1px rgba(148, 163, 184, 0.25);
}

.stage4-container::before {
    content: "";
    position: absolute;
    top: -100px;
    right: -60px;
    width: 260px;
    height: 260px;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.65), transparent 70%);
    filter: blur(10px);
    opacity: 0.9;
}

.stage4-container::after {
    content: "";
    position: absolute;
    bottom: -120px;
    left: -40px;
    width: 260px;
    height: 260px;
    background: radial-gradient(circle, rgba(250, 204, 21, 0.55), transparent 70%);
    filter: blur(12px);
    opacity: 0.85;
}

.stage4-hero {
    position: relative;
    z-index: 2;
}

.stage4-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 1rem;
    border-radius: 999px;

    background: linear-gradient(135deg, #0ea5e9, #22c55e);
    color: #f9fafb;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.08em;

    box-shadow:
        0 0 0 1px rgba(15, 23, 42, 0.8),
        0 12px 30px rgba(15, 118, 110, 0.8);
}

.stage4-badge::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #bbf7d0;
    box-shadow: 0 0 10px rgba(34, 197, 94, 0.9);
}

.stage4-title {
    margin-top: 1rem;
    margin-bottom: 0.3rem;
    font-size: 1.7rem;
    font-weight: 700;
    color: #e5e7eb;
    letter-spacing: 0.02em;
}

.stage4-subtitle {
    margin: 0;
    font-size: 0.9rem;
    color: #9ca3af;
    max-width: 680px;
}


.stage4-alert {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.15), rgba(16, 185, 129, 0.18));
    border: 1px solid rgba(59, 130, 246, 0.5);
    color: #dbeafe;
    backdrop-filter: blur(10px);
    font-size: 0.85rem;
}

.btn-neo4-primary {
    position: relative;
    margin-top: 1.4rem;
    border: none;
    background: transparent;
    cursor: pointer;
}

.btn4-glow {
    position: absolute;
    inset: -2px;
    border-radius: 999px;
    background:
        linear-gradient(135deg, rgba(59, 130, 246, 0.9), rgba(52, 211, 153, 0.9));
    filter: blur(6px);
    opacity: 0.8;
    transition: opacity 0.18s ease, transform 0.18s ease;
}

.btn4-label {
    position: relative;
    z-index: 1;
    padding: 0.65rem 1.7rem;
    border-radius: 999px;

    background: radial-gradient(circle at 20% 0%, #020617, #020617 70%);
    border: 1px solid rgba(148, 163, 184, 0.7);
    color: #e5f3ff;

    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.btn4-label::before {
    content: "●";
    font-size: 0.6rem;
    color: #4ade80;
}

.btn-neo4-primary:hover .btn4-glow {
    opacity: 1;
    transform: scale(1.03);
}

.data4-card {
    position: relative;
    z-index: 2;
    margin-top: 2rem;
    padding: 1.5rem 1.4rem;
    border-radius: 22px;

    background: linear-gradient(135deg, rgba(15, 23, 42, 0.96), rgba(15, 23, 42, 0.98));
    border: 1px solid rgba(31, 41, 55, 1);
    box-shadow:
        0 24px 50px rgba(15, 23, 42, 0.95),
        inset 0 0 0 1px rgba(148, 163, 184, 0.22);
    backdrop-filter: blur(16px);
}

.data4-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
}

.data4-card-title {
    margin: 0;
    font-size: 1.1rem;
    color: #e5e7eb;
}

.data4-card-subtitle {
    margin: 0.2rem 0 0;
    font-size: 0.8rem;
    color: #9ca3af;
}

.data4-card-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
}


.pill4 {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    font-size: 0.7rem;
    border: 1px solid rgba(148, 163, 184, 0.55);
    color: #e5e7eb;
    backdrop-filter: blur(8px);
}

.pill4-id {
    background: rgba(15, 118, 110, 0.5);
    border-color: rgba(34, 197, 94, 0.8);
}

.pill4-status {
    background: rgba(55, 65, 81, 0.85);
}

.pill4-ready {
    background: linear-gradient(135deg, #22c55e, #84cc16);
    border-color: rgba(190, 242, 100, 1);
    color: #022c22;
    box-shadow: 0 0 14px rgba(22, 163, 74, 0.9);
}

.pill4-stage {
    background: rgba(37, 99, 235, 0.25);
    border-color: rgba(59, 130, 246, 0.9);
}

.pill4-sensitive {
    background: rgba(220, 38, 38, 0.2);
    border-color: rgba(239, 68, 68, 0.9);
}


.data4-table-wrapper {
    max-height: 60vh;
    overflow: auto;
    border-radius: 18px;
    border: 1px solid rgba(31, 41, 55, 1);
    background:
        radial-gradient(circle at top left, rgba(30, 64, 175, 0.3), transparent 60%),
        rgba(15, 23, 42, 0.98);
}

.data4-table-wrapper::-webkit-scrollbar {
    height: 7px;
    width: 7px;
}
.data4-table-wrapper::-webkit-scrollbar-track {
    background: transparent;
}
.data4-table-wrapper::-webkit-scrollbar-thumb {
    background: rgba(75, 85, 99, 0.9);
    border-radius: 999px;
}

.neo4-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.8rem;
    color: #e5e7eb;
}

.neo4-table thead th {
    position: sticky;
    top: 0;
    z-index: 5;
    padding: 0.65rem 0.75rem;
    background: linear-gradient(135deg, #020617, #020617);
    border-bottom: 1px solid rgba(55, 65, 81, 1);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    white-space: nowrap;
}

.neo4-table tbody tr {
    transition: background 0.12s ease, transform 0.08s ease, box-shadow 0.12s ease;
}

.neo4-table tbody tr:nth-child(odd) {
    background: rgba(15, 23, 42, 0.96);
}
.neo4-table tbody tr:nth-child(even) {
    background: rgba(17, 24, 39, 0.96);
}

.neo4-table tbody tr:hover {
    background: linear-gradient(90deg, rgba(15, 118, 110, 0.25), rgba(15, 23, 42, 1));
    transform: translateY(-1px);
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.9);
}

.neo4-table td {
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid rgba(31, 41, 55, 1);
    white-space: nowrap;
}

@@media (max-width: 768px) {
    .stage4-container {
        padding: 1.8rem 1rem 2.2rem;
        border-radius: 18px;
    }

    .data4-card {
        padding: 1.1rem;
    }

    .neo4-table thead th,
    .neo4-table td {
        padding: 0.45rem 0.5rem;
    }
}
    </style>
