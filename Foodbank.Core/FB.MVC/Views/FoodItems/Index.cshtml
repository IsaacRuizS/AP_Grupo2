@model IEnumerable<FB.Data.FoodItem>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<div class="d-flex justify-content-between">
    <p>
        @Html.ActionLink("Create New", "Create")
    </p>
</div>

<button type="button" class="btn btn-danger my-2 fw-bold" data-bs-toggle="modal" data-bs-target="#miModal">
    <i class="bi-funnel-fill"></i>Filtrar tabla
</button>

<!-- Filter Modal -->
<div class="modal fade" id="miModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filtro de tabla</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">

                @using (Html.BeginForm("Index", "FoodItems", FormMethod.Get))
                {
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Rol</label>
                        @Html.DropDownList("roleName", (SelectList)ViewBag.RoleList, new { @class = "form-select", style = "min-width:160px" })
                    </div>

                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="omitirRol" id="omitirRol">
                            <label class="form-check-label" for="omitirRol">
                                Omitir búsqueda por roles
                            </label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Nombre</label>
                        <input type="text" class="form-control" name="name" placeholder="Buscar por nombre">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Categoría</label>
                        <input type="text" class="form-control" name="category" placeholder="Buscar por categoría">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Marca</label>
                        <input type="text" class="form-control" name="brand" placeholder="Buscar por marca">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Descripción</label>
                        <input type="text" class="form-control" name="description" placeholder="Buscar por descripción">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Precio Mínimo</label>
                        <input type="number" class="form-control" name="precioMin" placeholder="0.00" step="0.01">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Precio Máximo</label>
                        <input type="number" class="form-control" name="precioMax" placeholder="0.00" step="0.01">
                    </div>

                    <div class="col-md-12">
                        <span id="price-validation" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Unidad</label>
                        <input type="text" class="form-control" name="unit" placeholder="Buscar por unidad">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Cantidad en Stock</label>
                        <input type="number" class="form-control" name="quantity" placeholder="Cantidad">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Fecha Expiración Desde</label>
                        <input type="date" class="form-control" name="fechaDesde">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Fecha Expiración Hasta</label>
                        <input type="date" class="form-control" name="fechaHasta">
                    </div>

                    <div class="col-md-12">
                        <span id="date-validation" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">isPerishable</label>
                        <select class="form-select" name="isPerishable">
                            <option value="">Todos</option>
                            <option value="true">Sí</option>
                            <option value="false">No</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Calorías por Porción</label>
                        <input type="number" class="form-control" name="calories" placeholder="Calorías">
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Código de Barras</label>
                        <input type="text" class="form-control" name="barcode" placeholder="Buscar por código de barras">
                    </div>
                </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary fw-bold">Filtrar</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    </div>
                 }

            </div>
        </div>
    </div>
</div>


<table class="table table-responsive table-bordered table-dark table-striped table-primary">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Name)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Category)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Brand)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Description)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Price)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Unit)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.QuantityInStock)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ExpirationDate)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.IsPerishable)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CaloriesPerServing)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Ingredients)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Barcode)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Supplier)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.DateAdded)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.IsActive)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Role.RoleName)
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Brand)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Unit)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.QuantityInStock)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ExpirationDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsPerishable)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CaloriesPerServing)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Ingredients)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Barcode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Supplier)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateAdded)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsActive)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Role.RoleName)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = item.FoodItemID }) |
                @Html.ActionLink("Details", "Details", new { id = item.FoodItemID }) |
                @Html.ActionLink("Delete", "Delete", new { id = item.FoodItemID })
            </td>
        </tr>
    }

</table>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.querySelector('form');
    const precioMin = document.querySelector('input[name="precioMin"]');
    const precioMax = document.querySelector('input[name="precioMax"]');
    const fechaDesde = document.querySelector('input[name="fechaDesde"]');
    const fechaHasta = document.querySelector('input[name="fechaHasta"]');
    const priceValidation = document.getElementById('price-validation');
    const dateValidation = document.getElementById('date-validation');

    form.addEventListener('submit', function(e) {
        priceValidation.textContent = '';
        dateValidation.textContent = '';

        if (precioMin.value && isNaN(parseFloat(precioMin.value))) {
            e.preventDefault();
            priceValidation.textContent = 'El precio mínimo debe ser un número válido';
            return false;
        }

        if (precioMax.value && isNaN(parseFloat(precioMax.value))) {
            e.preventDefault();
            priceValidation.textContent = 'El precio máximo debe ser un número válido';
            return false;
        }

        if (precioMin.value && precioMax.value) {
            if (parseFloat(precioMin.value) > parseFloat(precioMax.value)) {
                e.preventDefault();
                priceValidation.textContent = 'El precio mínimo no puede ser mayor que el precio máximo';
                return false;
            }
        }

        if (fechaDesde.value && fechaHasta.value) {
            if (new Date(fechaDesde.value) > new Date(fechaHasta.value)) {
                e.preventDefault();
                dateValidation.textContent = 'La fecha inicial no puede ser mayor que la fecha final';
                return false;
            }
        }
    });
});
</script>