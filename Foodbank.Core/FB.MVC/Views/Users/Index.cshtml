@model IEnumerable<FB.Data.User>

@{
    ViewBag.Title = "Users";
}

<h2>Users</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.First().Username)</th>
            <th>@Html.DisplayNameFor(m => m.First().CreatedAt)</th>
            <th>@Html.DisplayNameFor(m => m.First().LastLogin)</th>
            <th>@Html.DisplayNameFor(m => m.First().IsActive)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Username)</td>
            <td>@Html.DisplayFor(modelItem => item.CreatedAt)</td>
            <td>@Html.DisplayFor(modelItem => item.LastLogin)</td>
            <td>@(item.IsActive ? "Active" : "Inactive")</td>
            <td>@Html.ActionLink("Edit", "Edit", new { id = item.UserId })</td>
        </tr>
}
    </tbody>
</table>
