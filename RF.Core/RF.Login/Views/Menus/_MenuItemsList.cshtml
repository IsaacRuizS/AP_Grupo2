@model IEnumerable<RF.Data.MenuItem>
@using Newtonsoft.Json


<div class="table-responsive">
    <table class="table table-dark table-hover">
        <thead class="table-secondary">
            <tr>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Precio</th>
                <th>Categoría</th>
                <th>Imagen</th>
                <th class="text-center">Estado</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>₡@item.Price.ToString("N2")</td>
                    <td>@item.Category</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl"
                                 style="height: 50px; width: 50px; object-fit: cover; border-radius: 6px;" />
                        }
                    </td>
                    <td class="text-center">
                        @if (item.IsActive == true)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactivo</span>
                        }
                    </td>

                    <td class="text-center">
                        <button class="btn btn-sm btn-warning"
                                onclick="editMenuItem(@item.ItemID)">
                            <i class="fa-solid fa-pen"></i>
                        </button>

                        <button class="btn btn-sm btn-danger"
                                onclick="deleteMenuItem(@item.ItemID)">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


<!-- FORMULARIO PARA CREAR / EDITAR ITEM -->
<div class="mt-4 p-3 border rounded bg-secondary">

    <h5 id="itemFormTitle">Agregar Nuevo Item</h5>

    @using (Html.BeginForm("SaveMenuItem", "Menus", FormMethod.Post, new { id = "menuItemForm" }))
    {
        <input type="hidden" id="ItemID" name="ItemID" value="0" />
        <input type="hidden" id="MenuID" name="MenuID" value="@ViewBag.MenuID" />

        <div class="row">
            <div class="col-md-6 mb-3">
                @Html.Label("Nombre")
                @Html.TextBox("Name", null, new { @class = "form-control" })
            </div>

            <div class="col-md-6 mb-3">
                @Html.Label("Categoría")
                @Html.TextBox("Category", null, new { @class = "form-control" })
            </div>

            <div class="col-md-12 mb-3">
                @Html.Label("Descripción")
                @Html.TextArea("Description", null, new { @class = "form-control", rows = 3 })
            </div>

            <div class="col-md-6 mb-3">
                @Html.Label("Precio")
                @Html.TextBox("Price", null, new { @class = "form-control", type = "number", step = "0.01" })
            </div>

            <div class="col-md-6 mb-3 d-flex align-items-center mt-4">
                <div class="form-check form-switch">
                    @Html.CheckBox("IsActive", true, new { @class = "form-check-input" })
                    @Html.Label("IsActive", "Activo", new { @class = "form-check-label" })
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-success w-100">
            <i class="fa-solid fa-save"></i> Guardar Item
        </button>
    }
</div>
<script>
    const items = @Html.Raw(
        JsonConvert.SerializeObject(
            Model.Select(x => new{
                x.ItemID,
                x.Name,
                x.Description,
                x.Price,
                x.IsActive,
                x.Category}
            )
        )
    );
</script>

<script>
    function editMenuItem(id) {

        const current = items.find(i => i.ItemID === id);

        $("#ItemID").val(current.ItemID);
        $("#Name").val(current.Name);
        $("#Description").val(current.Description);
        $("#Price").val(current.Price);
        $("#Category").val(current.Category);
        $("#IsActive").prop('checked', current.IsActive);

        $("#itemFormTitle").text("Editar Item");
    }

    function deleteMenuItem(id) {

        $.post("/Menus/DeleteMenuItem", { id: id }, function () {
            location.reload();
        });
    }
</script>
