@model RF.Data.Restaurant

@{
    ViewBag.Title = "Eliminar restaurante";
}

<h2 class="mb-4 text-center text-danger">
    <i class="fa-solid fa-trash-can me-2"></i> Eliminar Restaurante
</h2>

<div class="container bg-secondary p-4 rounded shadow-sm">

    <a href="@Url.Action("Index")" class="btn btn-secondary px-4">
        <i class="fa-solid fa-arrow-left me-1"></i> Volver a la lista
    </a>

    <div class="alert alert-danger text-center fw-bold mb-4">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>
        ¿Estás seguro de que deseas eliminar este restaurante?
        <br />
        <small>Esta acción no se puede deshacer.</small>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="">
                <dl class="row mb-0">
                    <dt class="col-sm-4 fw-bold">Nombre:</dt>
                    <dd class="col-sm-8 text-center">@Html.DisplayFor(model => model.Name)</dd>

                    <dt class="col-sm-4 fw-bold">Descripción:</dt>
                    <dd class="col-sm-8 text-center">@Html.DisplayFor(model => model.Description)</dd>

                    <dt class="col-sm-4 fw-bold">Dirección:</dt>
                    <dd class="col-sm-8 text-center">@Html.DisplayFor(model => model.Address)</dd>

                    <dt class="col-sm-4 fw-bold">Teléfono:</dt>
                    <dd class="col-sm-8 text-center">@Html.DisplayFor(model => model.Phone)</dd>

                    <dt class="col-sm-4 fw-bold">Correo electrónico:</dt>
                    <dd class="col-sm-8 text-center">@Html.DisplayFor(model => model.Email)</dd>

                    <dt class="col-sm-4 fw-bold">Sitio web:</dt>
                    <dd class="col-sm-8 text-center">
                        <a href="@Model.Website" target="_blank">@Html.DisplayFor(model => model.Website)</a>
                    </dd>

                    <dt class="col-sm-4 fw-bold">Waze:</dt>
                    <dd class="col-sm-8 text-center">
                        <a href="@Model.WazeLink" target="_blank">@Html.DisplayFor(model => model.WazeLink)</a>
                    </dd>

                    <dt class="col-sm-4 fw-bold">Google Maps:</dt>
                    <dd class="col-sm-8 text-center">
                        <a href="@Model.GoogleMapsLink" target="_blank">@Html.DisplayFor(model => model.GoogleMapsLink)</a>
                    </dd>

                    <dt class="col-sm-4 fw-bold">Latitud:</dt>
                    <dd class="col-sm-8 text-center">@Html.DisplayFor(model => model.Latitude)</dd>

                    <dt class="col-sm-4 fw-bold">Longitud:</dt>
                    <dd class="col-sm-8 text-center">@Html.DisplayFor(model => model.Longitude)</dd>

                    <dt class="col-sm-4 fw-bold">Calificación:</dt>
                    <dd class="col-sm-8 text-center">@Html.DisplayFor(model => model.Rating)</dd>

                    <dt class="col-sm-4 fw-bold">Activo:</dt>
                    <dd class="col-sm-8 text-center">
                        @(Model.IsActive == true ? "Sí" : "No")
                    </dd>

                    <dt class="col-sm-4 fw-bold">Creado:</dt>
                    <dd class="col-sm-8 text-center">@Html.DisplayFor(model => model.CreatedAt)</dd>

                    <dt class="col-sm-4 fw-bold">Actualizado:</dt>
                    <dd class="col-sm-8 text-center">@Html.DisplayFor(model => model.UpdatedAt)</dd>

                    <dt class="col-sm-4 fw-bold">Registrado por:</dt>
                    <dd class="col-sm-8 text-center">@Html.DisplayFor(model => model.User.FullName)</dd>

                    <dt class="col-sm-4 fw-bold">Imagen:</dt>
                    <dd class="col-sm-8 text-center">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="Imagen del restaurante" class="img-thumbnail rounded shadow-sm" style="max-width: 200px;" />
                        }
                        else
                        {
                            <span class="text-muted">No disponible</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="d-flex justify-content-center gap-3 mt-4">
            <button type="submit" class="btn btn-danger px-4">
                <i class="fa-solid fa-trash me-1"></i> Eliminar
            </button>
        </div>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
