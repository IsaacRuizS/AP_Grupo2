@model RF.Data.Restaurant

@{
    ViewBag.Title = "Eliminar Restaurante";
}

<div class="mb-4">
    <h2 class="text-danger">
        <i class="fa-solid fa-exclamation-triangle"></i> Eliminar Restaurante
    </h2>
    <div class="alert alert-danger my-4" role="alert">
        <strong>¿Está seguro que desea eliminar este restaurante?</strong>
    </div>
</div>

<div class="card bg-dark border-danger">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0">Información del Restaurante</h5>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-3">
                <strong>Nombre:</strong>
            </div>
            <div class="col-md-9">
                @Html.DisplayFor(model => model.Name)
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3">
                <strong>Descripción:</strong>
            </div>
            <div class="col-md-9">
                @Html.DisplayFor(model => model.Description)
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3">
                <strong>Dirección:</strong>
            </div>
            <div class="col-md-9">
                @Html.DisplayFor(model => model.Address)
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3">
                <strong>Teléfono:</strong>
            </div>
            <div class="col-md-9">
                @Html.DisplayFor(model => model.Phone)
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3">
                <strong>Email:</strong>
            </div>
            <div class="col-md-9">
                @Html.DisplayFor(model => model.Email)
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3">
                <strong>Calificación:</strong>
            </div>
            <div class="col-md-9">
                @if (Model.Rating.HasValue)
                {
                    <span class="badge bg-warning text-dark">
                        <i class="fa-solid fa-star"></i> @Model.Rating.Value.ToString("0.0")
                    </span>
                }
                else
                {
                    <span class="text-muted">N/A</span>
                }
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3">
                <strong>Estado:</strong>
            </div>
            <div class="col-md-9">
                @if (Model.IsActive.GetValueOrDefault())
                {
                    <span class="badge bg-success">Activo</span>
                }
                else
                {
                    <span class="badge bg-danger">Inactivo</span>
                }
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3">
                <strong>Dueño:</strong>
            </div>
            <div class="col-md-9">
                @Html.DisplayFor(model => model.User.FullName)
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="row mb-3">
                <div class="col-md-3">
                    <strong>Imagen:</strong>
                </div>
                <div class="col-md-9">
                    <img src="@Model.ImageUrl" alt="Imagen del restaurante" class="img-thumbnail" style="max-width: 300px;" />
                </div>
            </div>
        }
    </div>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="mt-4 d-flex gap-5">
        <button type="submit" class="btn btn-danger">
            <i class="fa-solid fa-trash"></i> Eliminar Restaurante
        </button>
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left"></i> Cancelar
        </a>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
