@using System.Security.Claims
@model RF.Data.Restaurant

@{
    ViewBag.Title = "Editar Restaurante";

    var claimsIdentity = (ClaimsIdentity)User.Identity;
    var userDbIdClaim = claimsIdentity.FindFirst("UserDBId");
    var userDbId = userDbIdClaim != null ? int.Parse(userDbIdClaim.Value) : 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Editar Restaurante</h2>
    <a href="@Url.Action("Index")" class="btn btn-secondary">
        <i class="fa-solid fa-arrow-left"></i> Volver
    </a>
</div>

@using (Html.BeginForm("Edit", "Restaurants", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="card bg-dark border-secondary">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Información del Restaurante</h5>
        </div>
        <div class="card-body">
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
            @Html.HiddenFor(model => model.RestaurantID)
            @Html.HiddenFor(model => model.ImageUrl)

            <div class="row">
                @if (User.IsInRole("Admin"))
                {
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(model => model.UserID, "Usuario", new { @class = "form-label" })
                        @Html.DropDownList("UserID", null, "Seleccione un usuario", new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.UserID, "", new { @class = "text-danger" })
                    </div>
                }
                else
                {
                    @Html.HiddenFor(model => model.UserID, new { Value = userDbId })
                }

                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Name, "Nombre", new { @class = "form-label" })
                    @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control", placeholder = "Ej. Restaurante La Casona" } })
                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Description, "Descripción", new { @class = "form-label" })
                    @Html.TextAreaFor(model => model.Description, new { @class = "form-control", rows = 3, placeholder = "Describe brevemente el restaurante" })
                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Address, "Dirección", new { @class = "form-label" })
                    @Html.EditorFor(model => model.Address, new { htmlAttributes = new { @class = "form-control", placeholder = "Ej. Avenida Central, San José" } })
                    @Html.ValidationMessageFor(model => model.Address, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Phone, "Teléfono", new { @class = "form-label" })
                    @Html.EditorFor(model => model.Phone, new { htmlAttributes = new { @class = "form-control", placeholder = "8888-8888" } })
                    @Html.ValidationMessageFor(model => model.Phone, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Email, "Correo Electrónico", new { @class = "form-label" })
                    @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control", placeholder = "correo@ejemplo.com", type = "email" } })
                    @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Website, "Sitio Web", new { @class = "form-label" })
                    @Html.EditorFor(model => model.Website, new { htmlAttributes = new { @class = "form-control", placeholder = "https://..." } })
                    @Html.ValidationMessageFor(model => model.Website, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6 mb-3">
                    @Html.Label("Imagen", "Imagen del Restaurante", new { @class = "form-label" })
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mb-2">
                            <img src="@Url.Content(Model.ImageUrl)" alt="Imagen Actual" style="max-height: 150px; max-width: 100%;" class="rounded border" />
                        </div>
                    }
                    <input type="file" name="imageFile" class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.WazeLink, "Enlace de Waze", new { @class = "form-label" })
                    @Html.EditorFor(model => model.WazeLink, new { htmlAttributes = new { @class = "form-control", placeholder = "https://waze.com/..." } })
                    @Html.ValidationMessageFor(model => model.WazeLink, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.GoogleMapsLink, "Enlace de Google Maps", new { @class = "form-label" })
                    @Html.EditorFor(model => model.GoogleMapsLink, new { htmlAttributes = new { @class = "form-control", placeholder = "https://maps.google.com/..." } })
                    @Html.ValidationMessageFor(model => model.GoogleMapsLink, "", new { @class = "text-danger" })
                </div>

                <div class="col-12 mb-3">
                    <div class="col-8 mb-3">
                        <label class="form-label">Seleccionar Ubicación en el Mapa</label>
                        <div id="map" style="height: 600px; width: 100%;" class="rounded border"></div>
                        <small class="text-muted">Haga clic en el mapa para establecer la ubicación.</small>
                    </div>
                </div>

                <div class="col-md-6 mb-3 d-none">
                    <input class="form-control" 
                           id="Latitude" 
                           name="Latitude" 
                           readonly="readonly" 
                           type="text" 
                           value="@(Model.Latitude.HasValue ? Model.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")" />
                </div>

                <div class="col-md-6 mb-3 d-none">
                    <input class="form-control" 
                           id="Longitude" 
                           name="Longitude" 
                           readonly="readonly" 
                           type="text" 
                           value="@(Model.Longitude.HasValue ? Model.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")" />
                </div>

                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Rating, "Calificación (0-5)", new { @class = "form-label" })
                    <input class="form-control" 
                           id="Rating" 
                           name="Rating" 
                           placeholder="0 - 5" 
                           type="number"
                           step="0.1"
                           min="0"
                           max="5"
                           value="@(Model.Rating.HasValue ? Model.Rating.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")" />
                    @Html.ValidationMessageFor(model => model.Rating, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.IsActive, "Estado", new { @class = "form-label" })
                    @Html.DropDownListFor(model => model.IsActive, new SelectList(new[] {
                        new { Value = true, Text = "Activo" },
                        new { Value = false, Text = "Inactivo" }
                    }, "Value", "Text", Model.IsActive), "Seleccione un estado", new { @class = "form-select" })
                    @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex gap-3">
        <button type="submit" class="btn btn-success">
            <i class="fa-solid fa-save"></i> Guardar Cambios
        </button>
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="fa-solid fa-times"></i> Cancelar
        </a>
    </div>
}

<style>
    .leaflet-marker-icon {
        background-color: transparent !important;
        border: none !important;
        box-shadow: none !important;
    }
</style>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    
    <script>
        if (typeof L !== 'undefined') {
            const config = {
                minZoom: 7,
                maxZoom: 18,
            };
            const zoom = 10;
            const defaultLat = 9.9281;
            const defaultLng = -84.0907;

            const map = L.map("map", config).setView([defaultLat, defaultLng], zoom);

            L.tileLayer("https://tiles.stadiamaps.com/tiles/alidade_smooth_dark/{z}/{x}/{y}{r}.png", {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
            }).addTo(map);

            let currentMarker = null;
            const latInput = document.getElementById("Latitude");
            const lngInput = document.getElementById("Longitude");

            function updateMarker(lat, lng) {
                if (currentMarker) {
                    map.removeLayer(currentMarker);
                }
                currentMarker = L.marker([lat, lng]).addTo(map);
            }

            map.on('click', function(e) {
                const lat = e.latlng.lat.toFixed(6);
                const lng = e.latlng.lng.toFixed(6);

                latInput.value = lat;
                lngInput.value = lng;

                updateMarker(lat, lng);
            });

            if (latInput.value && lngInput.value) {
                const lat = parseFloat(latInput.value);
                const lng = parseFloat(lngInput.value);
                if(!isNaN(lat) && !isNaN(lng)){
                    updateMarker(lat, lng);
                    map.setView([lat, lng], 15);
                }
            }
        } else {
            console.error("Leaflet library not found!");
        }
    </script>
}
