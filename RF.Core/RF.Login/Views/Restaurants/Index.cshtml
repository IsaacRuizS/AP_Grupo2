@model IEnumerable<RF.Data.Restaurant>

@{
    ViewBag.Title = "Index";
}


<div class="d-flex justify-content-between">
    <h2>Restaurantes</h2>
    <a href="@Url.Action("Create")" class="btn btn-primary d-flex align-items-center">
        <i class="fa-solid fa-plus me-1"></i> Agregar
    </a>
</div>

<table class="table table-responsive table-bordered table-dark table-striped table-primary mt-4">
    <tr>
        <th>
            <div>Nombre</div>
        </th>
        <th>
            <div>Descripción</div>
        </th>
        <th>
            <div>Dirección</div> 
        </th>
        <th style="width: 132px;">
            <div>Teléfono</div>
        </th>
        <th>
            <div>Email</div>
        </th>
        <th>
            <div>Calificación</div>
        </th>
        <th>
            <div>Estado</div>
        </th>
        <th>
            <div>Imagen</div>
        </th>
        <th>
            <div>Usuario</div>
        </th>
        <th style="width: 90px;">
            <div>Acciones</div>
        </th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Address)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Phone)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Rating)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsActive)
            </td>
            <td>
                <img src="@item.ImageUrl" alt="Imagen" style="width: 80px; height: auto; border-radius: 8px;" />
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.User.FullName)
            </td>
            <td>
                <a href="@Url.Action("Edit", new { id = item.RestaurantID })" class="text-primary me-2" title="Editar">
                    <i class="fa-solid fa-pen-to-square"></i>
                </a>
                <a href="@Url.Action("Delete", new { id = item.RestaurantID })" class="text-danger" title="Eliminar">
                    <i class="fa-solid fa-trash"></i>
                </a>
            </td>
        </tr>
    }

</table>
