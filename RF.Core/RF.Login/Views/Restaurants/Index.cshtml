@model IEnumerable<RF.Data.Restaurant>

@{
    ViewBag.Title = "Index";
}


<div class="d-flex justify-content-between">
    <h2>Restaurantes</h2>
    <a href="@Url.Action("Create")" class="btn btn-primary d-flex align-items-center">
        <i class="fa-solid fa-plus me-1"></i> Agregar
    </a>
</div>

<table class="table table-responsive table-bordered table-dark table-striped table-primary mt-4">
    <tr>
        <th>
            <div>Nombre</div>
        </th>
        <th>
            <div>Dueño</div>
        </th>
        <th>
            <div>Descripción</div>
        </th>
        <th>
            <div>Dirección</div>
        </th>
        <th>
            <div>Teléfono</div>
        </th>
        <th>
            <div>Email</div>
        </th>
        <th>
            <div>Calificación</div>
        </th>
        <th>
            <div>Estado</div>
        </th>
        <th></th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
<tr>
    <td>
        @Html.DisplayFor(modelItem => item.Name)
    </td>
    <td>
        @Html.DisplayFor(modelItem => item.User.FullName)
    </td>
    <td>
        @Html.DisplayFor(modelItem => item.Description)
    </td>
    <td>
        @Html.DisplayFor(modelItem => item.Address)
    </td>
    <td>
        @Html.DisplayFor(modelItem => item.Phone)
    </td>
    <td>
        @Html.DisplayFor(modelItem => item.Email)
    </td>
    <td>
        @Html.DisplayFor(modelItem => item.Rating)
    </td>
    <td>
        <input type="checkbox" checked="@item.IsActive" disabled />
    </td>

    <td>
        <a href="@Url.Action("Edit", new { id = item.RestaurantID })" title="Editar">
            <i class="fa-solid fa-pen-to-square text-primary"></i>
        </a>
    </td>
    <td>
        <a href="@Url.Action("Delete", new { id = item.RestaurantID })" title="Eliminar">
            <i class="fa-solid fa-trash text-danger"></i>
        </a>
    </td>
</tr>
    }

</table>
