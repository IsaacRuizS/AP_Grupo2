@model RF.Data.Schedule

@{
    ViewBag.Title = "Crear Horario";
    int restaurantId = ViewBag.RestaurantId;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Crear Nuevo Horario</h2>
    <a href="@Url.Action("Index", new { id = restaurantId })" class="btn btn-secondary">
        <i class="fa-solid fa-arrow-left"></i> Volver
    </a>
</div>

@using (Html.BeginForm("Create", "Schedules", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.Hidden("RestaurantID", restaurantId)

    <div class="card bg-dark border-secondary">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">Información del Horario</h5>
        </div>

        <div class="card-body">
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="row">

                <!-- Día de la Semana -->
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.DayOfWeek, "Día de la Semana", new { @class = "form-label" })
                    @Html.DropDownListFor(model => model.DayOfWeek,
                        new SelectList(new[]
                        {
                            new { Value = 1, Text = "Lunes" },
                            new { Value = 2, Text = "Martes" },
                            new { Value = 3, Text = "Miércoles" },
                            new { Value = 4, Text = "Jueves" },
                            new { Value = 5, Text = "Viernes" },
                            new { Value = 6, Text = "Sábado" },
                            new { Value = 7, Text = "Domingo" }
                        }, "Value", "Text"),
                        "Seleccione un día",
                        new { @class = "form-select" })
                    @Html.ValidationMessageFor(model => model.DayOfWeek, "", new { @class = "text-danger" })
                </div>

                <!-- Hora Apertura -->
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.OpenTime, "Hora de Apertura", new { @class = "form-label" })
                    <input type="time" name="OpenTime" class="form-control" required />
                    @Html.ValidationMessageFor(model => model.OpenTime, "", new { @class = "text-danger" })
                </div>

                <!-- Hora Cierre -->
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.CloseTime, "Hora de Cierre", new { @class = "form-label" })
                    <input type="time" name="CloseTime" class="form-control" required />
                    @Html.ValidationMessageFor(model => model.CloseTime, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex gap-3">
        <button type="submit" class="btn btn-success">
            <i class="fa-solid fa-plus"></i> Crear Horario
        </button>

        <a href="@Url.Action("Index", new { id = restaurantId })" class="btn btn-secondary">
            <i class="fa-solid fa-times"></i> Cancelar
        </a>
    </div>
}
