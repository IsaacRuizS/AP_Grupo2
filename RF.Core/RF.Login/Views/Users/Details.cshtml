@model RF.Data.User

@{
    ViewBag.Title = "Detalles del Usuario";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Detalles del Usuario</h2>
    <div>
        <a href="@Url.Action("Edit", new { id = Model.UserID })" class="btn btn-primary" title="Editar">
            <i class="fa-solid fa-edit"></i> Editar
        </a>
        <a href="@Url.Action("Index")" class="btn btn-secondary" title="Volver">
            <i class="fa-solid fa-arrow-left"></i> Volver
        </a>
    </div>
</div>

<div class="card bg-dark border-secondary">
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-3">
                <strong>Nombre Completo:</strong>
            </div>
            <div class="col-md-9">
                @Html.DisplayFor(model => model.FullName)
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3">
                <strong>Email:</strong>
            </div>
            <div class="col-md-9">
                @Html.DisplayFor(model => model.Email)
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3">
                <strong>Activo:</strong>
            </div>
            <div class="col-md-9">
                @if (Model.IsActive.GetValueOrDefault())
                {
                    <span class="badge bg-success">Sí</span>
                }
                else
                {
                    <span class="badge bg-danger">No</span>
                }
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3">
                <strong>Rol:</strong>
            </div>
            <div class="col-md-9">
                <span class="badge bg-primary">@Html.DisplayFor(model => model.UserRole.Name)</span>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3">
                <strong>Fecha de Creación:</strong>
            </div>
            <div class="col-md-9">
                @Html.DisplayFor(model => model.CreatedAt)
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3">
                <strong>Última Actualización:</strong>
            </div>
            <div class="col-md-9">
                @Html.DisplayFor(model => model.UpdatedAt)
            </div>
        </div>
    </div>
</div>
