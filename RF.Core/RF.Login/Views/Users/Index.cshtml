@model IEnumerable<RF.Data.User>

@{
    ViewBag.Title = "Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-3">Usuarios del Sistema</h2>
    </div>
    <div>
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Agregar Usuario
        </a>
    </div>
</div>

<div class="card bg-dark border-secondary">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0">
                <thead class="table-secondary">
                    <tr>
                        <th>Nombre</th>
                        <th>Email</th>
                        <th class="text-center">Estado</th>
                        <th>Rol</th>
                        <th>Fecha de Creación</th>
                        <th class="text-center" style="width: 150px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@Html.DisplayFor(modelItem => item.FullName)</strong>
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Email)
                            </td>
                            <td class="text-center">
                                @if (item.IsActive.GetValueOrDefault())
                                {
                                    <span class="badge bg-success">
                                        <i class="fa-solid fa-check"></i> Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        <i class="fa-solid fa-times"></i> Inactivo
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-primary">
                                    @Html.DisplayFor(modelItem => item.UserRole.Name)
                                </span>
                            </td>
                            <td>
                                @(item.CreatedAt.HasValue ? item.CreatedAt.Value.ToString("dd/MM/yyyy") : "N/A")
                            </td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a href="@Url.Action("Edit", new { id = item.UserID })" class="btn btn-sm btn-outline-secondary" title="Editar">
                                        <i class="fa-solid fa-edit text-primary"></i>
                                    </a>
                                    <a href="@Url.Action("Details", new { id = item.UserID })" class="btn btn-sm btn-outline-secondary" title="Detalles">
                                        <i class="fa-solid fa-info-circle text-info"></i>
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = item.UserID })" class="btn btn-sm btn-outline-secondary" title="Eliminar">
                                        <i class="fa-solid fa-trash text-danger"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info mt-3" role="alert">
        <i class="fa-solid fa-info-circle"></i>
        No hay usuarios registrados en el sistema.
    </div>
}
