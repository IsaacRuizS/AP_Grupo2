@model IEnumerable<RF.Data.Restaurant>

@{
    ViewBag.Title = "SignUp";
}


<div class="d-flex justify-content-between">
    <h2>Registrar Restaurantes</h2>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h4>Registro de Restaurante</h4>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("Create", "Restaurant", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                    

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">Registrar Restaurante</button>
                            @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
